{
    "name": "role_access/acl",
    "description": "Hierarchical route-name based ACL for Laravel",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "RoleAccess\\Acl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoleAccess\\Acl\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoleAccess\\Acl\\AclServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
